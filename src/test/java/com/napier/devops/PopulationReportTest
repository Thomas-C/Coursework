package com.napier.devops;

import com.napier.sem.PopulationReport;
import org.junit.jupiter.api.Test;

public class PopulationReportTest
{
    @Test
    void displayPopulationNullTest()
    {
        PopulationReport.displayPopulation(null);
    }

    @Test
    void displayPopulationTest()
    {
        PopulationReport report =
                new PopulationReport("Test Country", 100000L);

        PopulationReport.displayPopulation(report);
    }

    @Test
    void displayPopulationZeroTest()
    {
        PopulationReport report =
                new PopulationReport("Empty Country", 0L);

        PopulationReport.displayPopulation(report);
    }

    @Test
    void displayPopulationLargeNumberTest()
    {
        PopulationReport report =
                new PopulationReport("World", 8000000000L);

        PopulationReport.displayPopulation(report);
    }

    @Test
    void getWorldPopulationNullConnectionTest()
    {
        PopulationReport.getWorldPopulation(null);
    }

    @Test
    void getContinentPopulationNullConnectionTest()
    {
        PopulationReport.getContinentPopulation(null, "Europe");
    }

    @Test
    void getRegionPopulationNullConnectionTest()
    {
        PopulationReport.getRegionPopulation(null, "British Islands");
    }

    @Test
    void getCountryPopulationNullConnectionTest()
    {
        PopulationReport.getCountryPopulation(null, "United Kingdom");
    }
}
